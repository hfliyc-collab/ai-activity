{
  "manifest_version": 3,
  "name": "AI 活动 · 浏览器连接器",
  "version": "0.3.0",
  "description": "把 Claude、ChatGPT、Gemini 等网页的工作状态实时推送到桌面小组件“AI 活动”（Windows 必装，macOS 可选）。",
  "action": {
    "default_title": "AI 活动"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:47823/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://doubao.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://perplexity.ai/*",
        "https://qianwen.com/*",
        "https://tongyi.com/*",
        "https://www.chatgpt.com/*",
        "https://www.claude.ai/*",
        "https://www.doubao.com/*",
        "https://www.grok.com/*",
        "https://www.kimi.com/*",
        "https://www.perplexity.ai/*",
        "https://www.qianwen.com/*",
        "https://www.tongyi.com/*",
        "https://yuanbao.tencent.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://doubao.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://perplexity.ai/*",
        "https://qianwen.com/*",
        "https://tongyi.com/*",
        "https://www.chatgpt.com/*",
        "https://www.claude.ai/*",
        "https://www.doubao.com/*",
        "https://www.grok.com/*",
        "https://www.kimi.com/*",
        "https://www.perplexity.ai/*",
        "https://www.qianwen.com/*",
        "https://www.tongyi.com/*",
        "https://yuanbao.tencent.com/*"
      ],
      "js": [
        "sites.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}